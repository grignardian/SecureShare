# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
ENV/

# Local private/public user keys (never commit to Git)
keys/
local_keys/

# Server storage and SQLite databases (never commit user data)
server_data/
*.db
*.sqlite
*.sqlite3

# TLS private keys and local server certificates
certs/*.key
certs/*.crt
certs/*.pem

# Encrypted files and downloaded transfers
*.enc
*.secureshare
downloads/

# IDE and OS temporary files
.DS_Store
.idea/
.vscode/

# Offline app local identity and contacts
keys/
*.secureshare
local_data/
