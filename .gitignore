# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Local SQLite databases
*.db
secureshare.db

# Encrypted Vault & Local Storage (do not commit ciphertext or downloads)
encrypted_vault/*.enc
downloads/*
!downloads/.gitkeep
!encrypted_vault/.gitkeep

# Cryptographic Keys (Never commit private keys to GitHub)
user_keys/*.pem
!user_keys/.gitkeep

# Legacy / Synopsis documents
documentation/

# OS generated files
.DS_Store
.idea/
.vscode/
